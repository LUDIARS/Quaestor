    { "pathPattern": "(^|/)src/db/mail-messages-repo\\.ts$" },
    { "pathPattern": "(^|/)src/db/mail-watch-state-repo\\.ts$" },
    { "pathPattern": "(^|/)src/db/mail-action-throttle-repo\\.ts$" },
    { "pathPattern": "(^|/)src/db/inbound-documents-repo\\.ts$" },
    { "pathPattern": "(^|/)src/services/mail-intake-service\\.ts$" },
    { "pathPattern": "(^|/)src/services/mail-watch-runner\\.ts$" },
    { "pathPattern": "(^|/)src/services/mail-actions\\.ts$" },
    { "pathPattern": "(^|/)src/services/excubitor-catalog\\.ts$" },
    { "pathPattern": "(^|/)src/services/mail-notices\\.ts$" }
  ]
}
